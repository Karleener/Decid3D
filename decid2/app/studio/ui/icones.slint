// Icones (traces SVG 24 x 24, trait arrondi). Une icone = un nom ; la couleur vient du parent.
export global Icones {
    out property <string> soleil: "M8 12a4 4 0 108 0a4 4 0 10-8 0M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4";
    out property <string> lune: "M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z";
    out property <string> lecture: "M4 19 9 5l5 14M5.8 14h6.4M15 19v-5.5a2.5 2.5 0 015 0V19M20 16h-5";
    out property <string> fleche: "M5 12h14M13 6l6 6-6 6";
    out property <string> graine: "M12 21c0-6 0-9 4-13M12 13C8 13 5 10 5 6c4 0 7 3 7 7zM16 8c3 0 5-2 5-5-3 0-5 2-5 5z";
    out property <string> fiole: "M9 3h6M10 3v6l-5 9a2 2 0 002 3h10a2 2 0 002-3l-5-9V3M7.5 15h9";
    out property <string> dossier: "M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z";
    out property <string> retour: "M19 12H5M11 18l-6-6 6-6";
    out property <string> croix: "M6 6l12 12M18 6 6 18";
    out property <string> coche: "M5 12l5 5 9-10";
    // pictogramme d'une entree de menu, selon son action ("" : aucune)
    public pure function action(a: string) -> string {
        if (a == "nouveau") { return "M6 3h8l4 4v14H6zM14 3v4h4M12 11v6M9 14h6"; }
        if (a == "ouvrir") { return "M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"; }
        if (a == "enregistrer") { return "M5 3h11l3 3v15H5zM8 3v5h7V3M8 21v-7h8v7"; }
        if (a == "enregistrer-sous") { return "M5 3h11l3 3v6M5 3v18h7M8 3v5h7V3M15 21l6-6-2-2-6 6v2z"; }
        if (a == "importer") { return "M12 3v11M7 9l5 5 5-5M4 15v5h16v-5"; }
        if (a == "exporter") { return "M12 14V3M7 8l5-5 5 5M4 15v5h16v-5"; }
        if (a == "annuler") { return "M9 14 4 9l5-5M4 9h11a5 5 0 010 10h-3"; }
        if (a == "preferences") { return "M4 6h9M17 6h3M15 4v4M4 12h3M11 12h9M9 10v4M4 18h11M19 18h1M17 16v4"; }
        if (a == "theme") { return "M20 14.5A8 8 0 019.5 4 8 8 0 1020 14.5z"; }
        if (a == "lecture") { return "M4 19 9 5l5 14M5.8 14h6.4M15 19v-5.5a2.5 2.5 0 015 0V19M20 16h-5"; }
        if (a == "plein-ecran") { return "M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"; }
        if (a == "rafraichir") { return "M20 12a8 8 0 11-2.3-5.7M20 4v5h-5"; }
        if (a == "accueil") { return "M3 11 12 4l9 7M5 10v10h14V10M10 20v-5h4v5"; }
        if (a == "experiences") { return "M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01"; }
        if (a == "bac-a-sable") { return "M5 6h.01M10 12h.01M16 6h.01M18 14h.01M8 18h.01M14 19l6-6-2-2-6 6v2z"; }
        if (a == "pas-a-pas") { return "M6 5v14M10 5l9 7-9 7z"; }
        if (a == "validation") { return "M4 5h16v14H4zM9.3 5v14M14.6 5v14"; }
        if (a == "regression") { return "M4 20 20 4M7 15h.01M10 11h.01M14 12h.01M16 7h.01"; }
        if (a == "atelier-image") { return "M4 5h16v14H4zM4 16l5-5 4 4 3-3 4 4M15 9h.01"; }
        if (a == "decision") { return "M12 4a8 8 0 100 16 8 8 0 100-16M12 9a3 3 0 100 6 3 3 0 100-6"; }
        if (a == "generateur-2d") { return "M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"; }
        if (a == "guide") { return "M4 5a2 2 0 012-2h13v16H6a2 2 0 00-2 2zM4 21V5M8 7h7"; }
        if (a == "raccourcis") { return "M3 7h18v10H3zM7 11h.01M11 11h.01M15 11h.01M8 14h8"; }
        if (a == "a-propos") { return "M12 3a9 9 0 100 18 9 9 0 100-18M12 11v5M12 8h.01"; }
        if (a == "generateur-3d") { return "M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M6 18l2.5-2.5M15.5 8.5 18 6"; }
        if (a == "generateur-spirales") { return "M12 12a2 2 0 012 2 4 4 0 01-4 4 6 6 0 01-6-6 8 8 0 018-8 9 9 0 019 9"; }
        return "";
    }
    // pictogramme d'une famille d'algorithmes, selon son sigle
    public pure function famille(court: string) -> string {
        if (court == "SVM") { return "M5 19 19 5M3 13 13 3M11 21 21 11"; }
        if (court == "k-PPV") { return "M12 5a7 7 0 100 14 7 7 0 100-14M12 12h.01M9 9h.01M15 10h.01M13.5 15h.01M21 4h.01M3 20h.01"; }
        if (court == "Forêt") { return "M12 3 6 12h4l-4 6h12l-4-6h4zM12 18v3"; }
        if (court == "Bayes") { return "M3 19c4 0 5-13 9-13s5 13 9 13M3 19h18"; }
        if (court == "MLP") { return "M5 8 12 5M5 8l7 4M5 8l7 11M5 16 12 5M5 16l7-4M5 16l7 3M12 5l7 7M12 12h7M12 19l7-7"; }
        if (court == "Boost") { return "M4 19h4v-4h4v-4h4V7h4"; }
        if (court == "EM") { return "M3 12a5 7 0 1010 0 5 7 0 10-10 0M11 12a5 7 0 1010 0 5 7 0 10-10 0"; }
        return "";
    }
}

export component Icone inherits Path {
    in property <string> trace;
    in property <color> couleur;
    width: 20px;
    height: 20px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: trace;
    stroke: couleur;
    stroke-width: 1.8px;
    stroke-line-cap: round;
    fill: transparent;
}
