// Outil « Regression » : SVM, reseau, foret ou k-PPV predisent une valeur reelle.
// Le moteur publie les mesures (EQM, MAE, R2), une coupe du modele et les predictions ; le C++ les dessine.
import { Theme } from "../theme.slint";
import { Icone, Icones } from "../icones.slint";
import { Titre, Corps, Note, Bouton, Carte, Badge, Champ, Pilules, Defileur, Defilement } from "../composants.slint";
import { ParametreSaisi } from "bac-a-sable.slint";

export struct Mesure { nom: string, test: string, apprentissage: string }
export struct Essai { titre: string, r2: string, eqm: string, courant: bool }

export global Regression {
    in property <[string]> jeux;
    in-out property <int> jeu: 0;
    in property <string> fichier;                // fichier local choisi (prioritaire sur la bibliotheque)
    in-out property <int> en-tete: 0;            // 0 observation, 1 en-tete
    in-out property <int> separateur: 0;         // virgule, point-virgule, tabulation
    in property <bool> lu;
    in property <[string]> colonnes;
    in-out property <int> cible: 0;
    in property <string> premieres-lignes;
    in-out property <int> famille: 0;            // SVM, Reseau, Foret, k-PPV
    in property <string> famille-nom;
    in property <[ParametreSaisi]> parametres;
    in-out property <int> part: 1;               // 50, 70, 80 %
    in-out property <string> graine: "1";
    in property <[string]> entrees;              // colonnes sauf la cible
    in-out property <int> coupe: 0;
    in-out property <bool> normaliser: true;
    in property <bool> calcul;
    in property <string> erreur;
    // resultat
    in property <bool> essai-present;
    in-out property <int> vue: 0;                // 0 coupe du modele, 1 predit contre reel
    in property <image> plan;
    in property <string> legende;
    in property <string> r2;
    in property <string> titre-essai;
    in property <string> note-mesures;
    in property <[Mesure]> mesures;
    in property <[Essai]> essais;
    callback choisir-jeu(int);
    callback choisir-fichier();
    callback lire();
    callback choisir-cible(int);
    callback choisir-famille(int);
    callback changer-parametre(int, string);
    callback apprendre();
    callback choisir-essai(int);
    callback changer-vue();
    callback exporter();
    callback taille(length, length);
}

export component OutilRegression inherits Rectangle {
    property <length> col-g: 320px;
    property <length> col-d: 340px;

    Defilement {
        x: 0; y: 0; width: root.col-g; height: root.height;
        content-width: self.width;
        content-height: gauche.preferred-height;
        gauche := VerticalLayout {
            alignment: start;
            Carte {
                height: contenu-carte-0.preferred-height;
                contenu-carte-0 := VerticalLayout {
                    padding: Theme.e-lg; spacing: Theme.e-sm;
                    Titre { text: "Données"; corps: Theme.texte-md; }
                    Defileur { etiquette: "Bibliothèque"; options: Regression.jeux; choisi: Regression.jeu; change(i) => { Regression.choisir-jeu(i); } }
                    Note { text: "Ou un fichier de votre ordinateur"; font-size: Theme.texte-xs; }
                    Bouton { icone: Icones.dossier; texte: Regression.fichier != "" ? Regression.fichier : "Choisir un fichier CSV…"; clic => { Regression.choisir-fichier(); } }
                    Note { text: "Première ligne"; font-size: Theme.texte-xs; }
                    Pilules { options: ["une observation", "un en-tête"]; choisi <=> Regression.en-tete; }
                    Note { text: "Séparateur"; font-size: Theme.texte-xs; }
                    Pilules { options: ["virgule", "point-virgule", "tabulation"]; choisi <=> Regression.separateur; }
                    Bouton { texte: "Lire le fichier"; clic => { Regression.lire(); } }
                    if Regression.lu: Rectangle {
                        height: bloc-0.preferred-height;
                        bloc-0 := VerticalLayout {
                            spacing: Theme.e-sm;
                            Defileur { etiquette: "Valeur à prédire"; options: Regression.colonnes; choisi: Regression.cible; change(i) => { Regression.choisir-cible(i); } }
                            Note { text: "Premières lignes : " + Regression.premieres-lignes; font-size: Theme.texte-xs; }
                            Rectangle { height: Theme.e-xs; }
                            Text { text: "Apprendre"; font-family: Theme.police-texte; font-size: Theme.texte-sm; font-weight: 600; color: Theme.encre; }
                            Pilules { options: ["SVM", "Réseau", "Forêt", "k-PPV"]; choisi: Regression.famille; change(i) => { Regression.choisir-famille(i); } }
                            Note { text: Regression.famille-nom; font-size: Theme.texte-xs; }
                            for p[i] in Regression.parametres: VerticalLayout {
                                spacing: 4px;
                                Note { text: p.libelle; font-size: Theme.texte-xs; }
                                Champ { texte: p.valeur; info: p.libelle; genre: decimal; valide(t) => { Regression.changer-parametre(i, t); } }
                            }
                            Note { text: "Part d’apprentissage et graine"; font-size: Theme.texte-xs; }
                            HorizontalLayout {
                                spacing: Theme.e-sm;
                                Pilules { horizontal-stretch: 1; options: ["50 %", "70 %", "80 %"]; choisi <=> Regression.part; }
                                Champ { width: 80px; texte <=> Regression.graine; info: "Graine du tirage"; genre: number; }
                            }
                            if Regression.entrees.length > 0: Defileur { etiquette: "Coupe le long de"; options: Regression.entrees; choisi <=> Regression.coupe; }
                            HorizontalLayout {
                                spacing: Theme.e-xs; height: 28px;
                                Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    width: 18px; height: 18px; border-radius: 4px; border-width: 2px;
                                    border-color: Regression.normaliser ? Theme.accent-texte : Theme.filet-fort;
                                    background: Regression.normaliser ? Theme.accent : transparent;
                                    accessible-role: checkbox; accessible-label: "ramener chaque entrée dans [0, 1]"; accessible-checked: Regression.normaliser;
                                    TouchArea { clicked => { Regression.normaliser = !Regression.normaliser; } }
                                }
                                Corps { text: "ramener chaque entrée dans [0, 1] (min-max de l’apprentissage)"; vertical-alignment: center; font-size: Theme.texte-xs; }
                            }
                            Bouton { genre: "principal"; actif: !Regression.calcul; texte: Regression.calcul ? "Apprentissage par le moteur…" : "Apprendre et évaluer"; clic => { Regression.apprendre(); } }
                            Note { text: "Les lignes sont mélangées avec la graine, puis coupées en apprentissage et test. Le test ne sert qu’à mesurer."; font-size: Theme.texte-xs; }
                        }
                    }
                    if Regression.erreur != "": Text { text: Regression.erreur; wrap: word-wrap; font-size: Theme.texte-sm; color: Theme.alerte; }
                }
            }
        }
    }

    // ---- vue
    centre := Rectangle {
        x: root.col-g + Theme.e-lg; y: 0;
        width: root.width - root.col-g - root.col-d - 2 * Theme.e-lg; height: root.height;
        if !Regression.essai-present: Carte {
            height: vv.preferred-height;
            vv := VerticalLayout {
                padding: Theme.e-lg;
                Corps { text: Regression.lu ? "Choisissez un algorithme puis « Apprendre et évaluer ». La courbe et les points viendront des artefacts du moteur." : "Lisez d’abord un fichier : la colonne cible doit contenir des nombres."; }
            }
        }
        if Regression.essai-present: Rectangle {
            height: bloc-1.preferred-height;
            bloc-1 := VerticalLayout {
                spacing: Theme.e-sm;
                HorizontalLayout { alignment: start; Pilules { width: 320px; options: ["Coupe du modèle", "Prédit contre réel"]; choisi <=> Regression.vue; change => { Regression.changer-vue(); } } }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-plot; border-width: 1px; border-color: Theme.filet; border-radius: Theme.r-lg; clip: true;
                    changed width => { Regression.taille(self.width, self.height); }
                    changed height => { Regression.taille(self.width, self.height); }
                    init => { Regression.taille(self.width, self.height); }
                    Image { width: parent.width; height: parent.height; source: Regression.plan; image-fit: fill; }
                }
                Note { text: Regression.legende; font-size: Theme.texte-xs; }
            }
        }
    }

    // ---- mesures et essais
    Defilement {
        x: root.width - root.col-d; y: 0; width: root.col-d; height: root.height;
        content-width: self.width;
        content-height: droite.preferred-height;
        droite := VerticalLayout {
            spacing: Theme.e-lg; alignment: start;
            Carte {
                height: contenu-carte-1.preferred-height;
                contenu-carte-1 := VerticalLayout {
                    padding: Theme.e-lg; spacing: Theme.e-sm;
                    if !Regression.essai-present: Titre { text: "Mesures"; corps: Theme.texte-md; }
                    if !Regression.essai-present: Note { text: "EQM, MAE et R² apparaîtront ici, sur l’apprentissage et sur le test."; }
                    if Regression.essai-present: Rectangle {
                        height: bloc-2.preferred-height;
                        bloc-2 := VerticalLayout {
                            spacing: Theme.e-sm;
                            Note { text: "R² sur le test · " + Regression.titre-essai; font-size: Theme.texte-xs; }
                            Text { text: Regression.r2; font-family: Theme.police-titre; font-size: Theme.texte-2xl; color: Theme.encre; }
                            Note { text: Regression.note-mesures; font-size: Theme.texte-xs; }
                            HorizontalLayout {
                                height: 24px;
                                Note { horizontal-stretch: 1; text: ""; }
                                Note { width: 90px; text: "test"; horizontal-alignment: right; font-size: Theme.texte-xs; font-weight: 600; }
                                Note { width: 110px; text: "apprentissage"; horizontal-alignment: right; font-size: Theme.texte-xs; font-weight: 600; }
                            }
                            for m in Regression.mesures: HorizontalLayout {
                                height: 26px;
                                Corps { horizontal-stretch: 1; text: m.nom; vertical-alignment: center; font-size: Theme.texte-sm; }
                                Text { width: 90px; text: m.test; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.police-texte; font-size: Theme.texte-sm; font-weight: 600; color: Theme.encre; }
                                Text { width: 110px; text: m.apprentissage; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.police-texte; font-size: Theme.texte-sm; color: Theme.encre-2; }
                            }
                            Note { text: "EQM : moyenne des carrés des écarts entre valeur réelle et prédiction. MAE : moyenne des écarts absolus. R² : 1 − (somme des carrés des écarts / somme des carrés autour de la moyenne)."; font-size: Theme.texte-xs; }
                            Bouton { icone: Icones.dossier; texte: "Prédictions (CSV)"; clic => { Regression.exporter(); } }
                        }
                    }
                }
            }
            if Regression.essais.length > 0: Carte {
                height: contenu-carte-2.preferred-height;
                contenu-carte-2 := VerticalLayout {
                    padding: Theme.e-lg; spacing: 4px;
                    HorizontalLayout { Titre { text: "Essais"; corps: Theme.texte-md; } Note { text: "même cible, à comparer"; horizontal-alignment: right; vertical-alignment: center; font-size: Theme.texte-xs; } }
                    HorizontalLayout {
                        height: 24px;
                        Note { horizontal-stretch: 1; text: "algorithme"; font-size: Theme.texte-xs; font-weight: 600; }
                        Note { width: 60px; text: "R² test"; horizontal-alignment: right; font-size: Theme.texte-xs; font-weight: 600; }
                        Note { width: 70px; text: "EQM test"; horizontal-alignment: right; font-size: Theme.texte-xs; font-weight: 600; }
                    }
                    for e[k] in Regression.essais: Rectangle {
                        height: 30px; border-radius: 6px;
                        background: e.courant ? Theme.accent-doux : z.has-hover ? Theme.surface-3 : transparent;
                        HorizontalLayout {
                            padding-left: 4px; padding-right: 4px;
                            Text { horizontal-stretch: 1; text: e.titre; vertical-alignment: center; overflow: elide; font-family: Theme.police-texte; font-size: Theme.texte-xs; color: Theme.encre; }
                            Text { width: 60px; text: e.r2; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.police-texte; font-size: Theme.texte-xs; font-weight: 600; color: Theme.encre; }
                            Text { width: 70px; text: e.eqm; horizontal-alignment: right; vertical-alignment: center; font-family: Theme.police-texte; font-size: Theme.texte-xs; color: Theme.encre-2; }
                        }
                        z := TouchArea { mouse-cursor: pointer; clicked => { Regression.choisir-essai(k); } }
                    }
                }
            }
        }
    }
}
